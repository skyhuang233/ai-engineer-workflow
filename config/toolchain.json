      "owner": "skyhuang233",
      "required_scopes": ["repo", "workflow"],
      "plaintext_relative_path": "state\\credentials\\github.pat"
    }
  },
  "upgrade": {
    "rule": "Upgrade no-mistakes only through a pinned repository commit and clean source build; admit every tool upgrade only through an accepted main commit, final Workflow Release Manifest, complete doctor run, and automatic activation for new Worker Runs."
  }
